{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "my-halaqoh",
          "appId": "1:1071363025152:android:c88c52a6741537ebdf6be5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "my-halaqoh",
          "configurations": {
            "android": "1:1071363025152:android:c88c52a6741537ebdf6be5",
            "ios": "1:1071363025152:ios:cc28a086a6875950df6be5"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web_legal",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/privacy-policy-en*",
        "destination": "/privacy_policy_en.html"
      },
      {
        "source": "/privacy-en*",
        "destination": "/privacy_policy_en.html"
      },
      {
        "source": "/privacy-policy*",
        "destination": "/privacy_policy.html"
      },
      {
        "source": "/privacy_policy*",
        "destination": "/privacy_policy.html"
      },
      {
        "source": "/account-deletion-en*",
        "destination": "/account_deletion_en.html"
      },
      {
        "source": "/account-deletion*",
        "destination": "/account_deletion.html"
      },
      {
        "source": "/account_deletion*",
        "destination": "/account_deletion.html"
      },
      {
        "source": "/support-en*",
        "destination": "/support_en.html"
      },
      {
        "source": "/support*",
        "destination": "/support.html"
      },
      {
        "source": "/terms-en*",
        "destination": "/terms_conditions_en.html"
      },
      {
        "source": "/terms-conditions-en*",
        "destination": "/terms_conditions_en.html"
      },
      {
        "source": "/terms*",
        "destination": "/terms_conditions.html"
      },
      {
        "source": "/terms-conditions*",
        "destination": "/terms_conditions.html"
      }
    ]
  }
